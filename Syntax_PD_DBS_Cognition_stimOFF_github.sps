  /CRITERIA ALPHA=0.05 CILEVEL=95
  /MISSING SCOPE=ANALYSIS USERMISSING=EXCLUDE.

NPTESTS
  /RELATED TEST(MTTMTCMD_12MFU MTTMTCMD_12MFU_STIM_OFF) WILCOXON HODGES_LEHMAN
  /CRITERIA ALPHA=0.05 CILEVEL=95
