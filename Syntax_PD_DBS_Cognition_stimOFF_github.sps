  /RELATED TEST(RTIFMDMT_12MFU RTIFMDMT_12MFU_STIM_OFF) WILCOXON HODGES_LEHMAN
  /CRITERIA ALPHA=0.05 CILEVEL=95
  /MISSING SCOPE=ANALYSIS USERMISSING=EXCLUDE.

NPTESTS
  /RELATED TEST(PRMPCI_12MFU PRMPCI_12MFU_STIM_OFF) WILCOXON HODGES_LEHMAN
  /CRITERIA ALPHA=0.05 CILEVEL=95
  /MISSING SCOPE=ANALYSIS USERMISSING=EXCLUDE.

NPTESTS
  /RELATED TEST(SSPFSL_12MFU SSPFSL_12MFU_STIM_OFF) WILCOXON HODGES_LEHMAN
  /CRITERIA ALPHA=0.05 CILEVEL=95
  /MISSING SCOPE=ANALYSIS USERMISSING=EXCLUDE.

NPTESTS
  /RELATED TEST(SSPRSL_12MFU SSPRSL_12MFU_STIM_OFF) WILCOXON HODGES_LEHMAN
  /CRITERIA ALPHA=0.05 CILEVEL=95
  /MISSING SCOPE=ANALYSIS USERMISSING=EXCLUDE.

NPTESTS
  /RELATED TEST(ERTTH_12MFU ERTTH_12MFU_STIM_OFF) WILCOXON HODGES_LEHMAN
  /CRITERIA ALPHA=0.05 CILEVEL=95
  /MISSING SCOPE=ANALYSIS USERMISSING=EXCLUDE.

NPTESTS
  /RELATED TEST(PRMPCD_12MFU PRMPCD_12MFU_STIM_OFF) WILCOXON HODGES_LEHMAN
  /CRITERIA ALPHA=0.05 CILEVEL=95
  /MISSING SCOPE=ANALYSIS USERMISSING=EXCLUDE.

NPTESTS
  /RELATED TEST(VRMFRDS_12MFU VRMFRDS_12MFU_STIM_OFF) WILCOXON HODGES_LEHMAN
  /CRITERIA ALPHA=0.05 CILEVEL=95
  /MISSING SCOPE=ANALYSIS USERMISSING=EXCLUDE.

NPTESTS
  /RELATED TEST(VRMIRTC_12MFU VRMIRTC_12MFU_STIM_OFF) WILCOXON HODGES_LEHMAN
  /CRITERIA ALPHA=0.05 CILEVEL=95
  /MISSING SCOPE=ANALYSIS USERMISSING=EXCLUDE.

NPTESTS
  /RELATED TEST(MTTTIC_12MFU MTTTIC_12MFU_STIM_OFF) WILCOXON HODGES_LEHMAN
  /CRITERIA ALPHA=0.05 CILEVEL=95
  /MISSING SCOPE=ANALYSIS USERMISSING=EXCLUDE.

NPTESTS
  /RELATED TEST(MTTLMD_12MFU MTTLMD_12MFU_STIM_OFF) WILCOXON HODGES_LEHMAN
  /CRITERIA ALPHA=0.05 CILEVEL=95
  /MISSING SCOPE=ANALYSIS USERMISSING=EXCLUDE.

NPTESTS
